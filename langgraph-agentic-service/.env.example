# ===========================================
# LangGraph Agentic Service - Environment Variables
# ===========================================

# OpenAI API (LangChain LLM)
OPENAI_API_KEY=sk-your-openai-api-key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# vLLM Server (Optional - for custom model serving)
VLLM_API_URL=http://localhost:8080
VLLM_SERVER_URL=http://localhost:8080
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Langfuse Monitoring
LANGFUSE_PUBLIC_KEY=pk-your-public-key
LANGFUSE_SECRET_KEY=sk-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# HuggingFace (for model downloads)
HF_TOKEN=hf_your_token

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIR=./data/chroma

# Application
LOG_LEVEL=INFO
DEBUG=false

# Docker Compose specific (for Langfuse)
NEXTAUTH_SECRET=your-nextauth-secret-for-langfuse
SALT=your-salt-for-langfuse
